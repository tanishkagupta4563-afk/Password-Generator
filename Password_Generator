#Password_Generator

import random
import string

print("Hello, Welcome to Password Generator")

# Length suggestion
print("\n Recommended: 12+ characters for strong security")

length = int(input('\n Enter the length of the password: '))

# Warning if length is less than 12
if length < 12:
    print("Warning: Password length should be at least 12 characters for better security.")

lower = string.ascii_lowercase
upper = string.ascii_uppercase
numbers = string.digits
symbols = string.punctuation

all = lower + upper + numbers + symbols

temp = random.sample(all, length)
password = "".join(temp)
print(password)
