# Password_Generator 

import secrets
import string

print("Hello, Welcome to Password Generator")

# 1. Length suggestion
print("\nRecommended: 12+ characters for strong security")

length = int(input('\nEnter the length of the password: '))


if length < 12:
    print("Warning: Password length should be at least 12 characters for better security.")

# 2. Take 2 favorite\random words
word1 = input("\nEnter your first favorite word: ").strip().replace(" ", "")
word2 = input("\nEnter your second favorite word: ").strip().replace(" ", "")

# Replace characters 
def replace_chars(word):
    replacements = {
        'a': '@',
        's': '$',
        'i': '1',
        'o': '0',
        'e': '3',
        'b': '6',
        'c': '(',
        
    }
    return ''.join(replacements.get(c.lower(), c) for c in word)

word1 = replace_chars(word1)
word2 = replace_chars(word2)

# Combine words 
base_password = word1 + word2

# Random characters
extra_chars = string.digits + string.punctuation

remaining_length = length - len(base_password)

# Add randomness only at the end
if remaining_length > 0:
    random_part = ''.join(secrets.choice(extra_chars) for _ in range(remaining_length))
    password = base_password + random_part
else:
    # If words are too long, cut from end
    password = base_password[:length]

print("\nGenerated Password:", password)